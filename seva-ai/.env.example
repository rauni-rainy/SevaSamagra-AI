# ==============================================================================
# SevaSamagra AI - Environment Variables
# ==============================================================================

# ----------------- #
# Backend Variables #
# ----------------- #
# The environment we are running in (development, staging, production)
ENVIRONMENT=development
# The secret key for JWT/Session signing
SECRET_KEY=your_secret_key_here
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/sevasamagra
# OpenAI API key for Whisper and LLM integration
OPENAI_API_KEY=sk-your-openai-api-key
# Twilio credentials for IVR and WhatsApp integration
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ------------------ #
# Frontend Variables #
# ------------------ #
# Public URL of the frontend app (used by backend for CORS etc)
FRONTEND_URL=http://localhost:3000
# Backend API URL (used by frontend to connect to the backend)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Socket.io connection URL
NEXT_PUBLIC_SOCKET_URL=ws://localhost:8000
